# Configuração para OpenAI Whisper (opcional)
# Obter chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sua_chave_aqui

# Configuração de idioma (padrão: pt-BR)
# Exemplos: pt-BR, en-US, es-ES, fr-FR
LANGUAGE=pt-BR

# Motor de transcrição (padrão: google)
# Opções: google, whisper
TRANSCRIPTION_ENGINE=google
